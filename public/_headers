# Cloudflare Pages reads this file verbatim. Rules are matched top to bottom.

/*
  # Third-party images go through /api/image, so nothing off-origin is loaded
  # directly — which is what lets img-src stay this tight. `data:` is for the
  # inline SVG favicon. `style-src` needs 'unsafe-inline' because React writes
  # style attributes on elements; there is no inline <script> anywhere.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; manifest-src 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed filenames, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The dataset is fetched with a cache-busting query string; keeping the edge
# copy short means a refreshed deploy is visible within minutes either way.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

# The preview card only changes when the brand does.
/og.png
  Cache-Control: public, max-age=604800
